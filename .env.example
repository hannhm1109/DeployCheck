DATABASE_URL="postgresql://postgres:postgres@localhost:55432/deploycheck?schema=public"
# For Supabase on Vercel, use the transaction pooler (:6543) for DATABASE_URL.
# Use the direct URL for migrations, or the session pooler (:5432) if IPv6 is unavailable.
# Local Docker can use DATABASE_URL for both, so DIRECT_URL is optional here.
# DIRECT_URL="postgresql://postgres:postgres@localhost:55432/deploycheck?schema=public"
# Generate a unique secret with: node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
BETTER_AUTH_SECRET="replace-with-a-random-secret-at-least-32-characters-long"
BETTER_AUTH_URL="http://localhost:3000"
# Set READ_ONLY_DEMO=true only for an intentionally non-editable deployment.
